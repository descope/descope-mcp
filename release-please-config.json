{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "descope-mcp",
      "extra-files": [
        {
          "type": "toml",
          "path": "python/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "python/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='descope-mcp')].version"
        },
        {
          "type": "generic",
          "path": "python/src/descope_mcp/__init__.py"
        }
      ]
    }
  }
}
